{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:membrane-vqc:schema:batch-result:1.0",
  "title": "Membrane Visual QC batch result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "plan_sha256", "run_id", "software", "started_at", "completed_at", "execution", "jobs", "counts", "overall_status", "identity_core_sha256"],
  "properties": {
    "contract": {"const": "mvqc-batch-result-1.0"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/digest"},
    "software": {
      "type": "object", "additionalProperties": false, "required": ["version", "commit"],
      "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 64}, "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["failure_policy", "overwrite"],
      "properties": {"failure_policy": {"enum": ["continue_on_error", "fail_fast"]}, "overwrite": {"enum": ["refuse", "same_batch"]}}
    },
    "jobs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/jobResult"}},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "SUCCESS", "REVIEW_ITEMS", "INSUFFICIENT_CONTEXT", "ANALYSIS_ERROR", "INPUT_REJECTED", "CANCELLED", "SKIPPED_DEPENDENCY"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 100},
        "SUCCESS": {"type": "integer", "minimum": 0}, "REVIEW_ITEMS": {"type": "integer", "minimum": 0},
        "INSUFFICIENT_CONTEXT": {"type": "integer", "minimum": 0}, "ANALYSIS_ERROR": {"type": "integer", "minimum": 0},
        "INPUT_REJECTED": {"type": "integer", "minimum": 0}, "CANCELLED": {"type": "integer", "minimum": 0},
        "SKIPPED_DEPENDENCY": {"type": "integer", "minimum": 0}
      }
    },
    "overall_status": {"enum": ["COMPLETED", "COMPLETED_WITH_ERRORS", "FAILED_FAST", "CANCELLED"]},
    "identity_core_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": ["string", "null"], "pattern": "^(?![/\\\\]|[A-Za-z]:|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[A-Za-z0-9._/-]{1,512}$"},
    "identity": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["path", "size", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "jobResult": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "mode", "status", "error_code", "report", "report_schema", "csv", "warnings_count", "review_items_count", "coordinate_preserved"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^(?!batch-result$)[a-z][a-z0-9_-]{0,63}$"},
        "mode": {"enum": ["legacy_global_z", "planar_orientation", "pdbtm_local", "pdbtm_cache", "pdbtm_opm_comparison"]},
        "status": {"enum": ["SUCCESS", "REVIEW_ITEMS", "INSUFFICIENT_CONTEXT", "ANALYSIS_ERROR", "INPUT_REJECTED", "CANCELLED", "SKIPPED_DEPENDENCY"]},
        "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "report": {"$ref": "#/$defs/identity"}, "report_schema": {"type": ["string", "null"], "pattern": "^1\\.[0-5]$"},
        "csv": {"$ref": "#/$defs/identity"}, "warnings_count": {"type": "integer", "minimum": 0},
        "review_items_count": {"type": ["integer", "null"], "minimum": 0}, "coordinate_preserved": {"type": ["boolean", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "pdbtm_local"}}}, "then": {"properties": {"report_schema": {"enum": ["1.3", null]}}}},
        {"if": {"properties": {"mode": {"const": "pdbtm_cache"}}}, "then": {"properties": {"report_schema": {"enum": ["1.4", null]}}}},
        {"if": {"properties": {"mode": {"const": "pdbtm_opm_comparison"}}}, "then": {"properties": {"report_schema": {"enum": ["1.5", null]}, "csv": {"type": "null"}}}},
        {"if": {"properties": {"mode": {"enum": ["legacy_global_z", "planar_orientation"]}}}, "then": {"properties": {"report_schema": {"enum": ["1.1", "1.2", null]}}}},
        {"if": {"properties": {"status": {"enum": ["SUCCESS", "REVIEW_ITEMS", "INSUFFICIENT_CONTEXT"]}}}, "then": {"properties": {"error_code": {"type": "null"}, "report": {"type": "object"}, "coordinate_preserved": {"const": true}}}},
        {"if": {"properties": {"status": {"enum": ["ANALYSIS_ERROR", "INPUT_REJECTED", "CANCELLED", "SKIPPED_DEPENDENCY"]}}}, "then": {"properties": {"report": {"type": "null"}, "report_schema": {"type": "null"}, "csv": {"type": "null"}, "coordinate_preserved": {"type": "null"}}}}
      ]
    }
  }
}
